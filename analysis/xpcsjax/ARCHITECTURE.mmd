graph TD
    subgraph Config["Config & Parameter Registry"]
        CFGmgr[config/manager.py]
        CFGreg[config/parameter_registry.py]
    end

    subgraph CorePhysics["Physics Core"]
        COREjax[core/jax_backend.py]
        COREhom[core/homodyne_model.py]
        COREhet[core/heterodyne_jax_backend.py]
    end

    subgraph Data["Data Ingestion & QC"]
        DATAload[data/xpcs_loader.py]
        DATAopt[data/optimization.py MCMC guard]
    end

    subgraph NLSQ["NLSQ Optimization Engine"]
        NLSQcore[optimization/nlsq/core.py]
        NLSQwrap[optimization/nlsq/wrapper.py]
        NLSQadapt[optimization/nlsq/model_adapter.py]
        NLSQstrat[optimization/nlsq/strategies/residual_jit.py]
    end

    subgraph AntiDeg["5-Layer Anti-Degeneracy"]
        AD1[per_angle_mode.py L1]
        AD2[hierarchical.py L2]
        AD3[adaptive_regularization.py L3]
        AD4[gradient_monitor.py L4]
        AD5[shear_weighting.py L5]
    end

    subgraph Heterodyne["Heterodyne Optimization Subsystem"]
        HETcore[heterodyne_core.py]
        HETengine[heterodyne_engine_route.py]
        HETstrat[heterodyne_stratified_ls.py]
    end

    subgraph Device["Device / Runtime"]
        DEVcpu[device/cpu.py]
        RUNTshell[runtime/shell/completion_spec.py]
        INITenv[xpcsjax/__init__.py XLA env]
    end

    subgraph CLI["CLI"]
        CLImain[cli/main.py]
        CLIcfg[cli/config_generator.py]
        CLIplot[cli/plot_dispatch.py]
    end

    subgraph Service["Service Layer"]
        SVCevents[service/events.py JAX-free]
        SVCfit[service/fit.py worker-only]
        SVCdata[service/data.py]
        SVCplots[service/plots.py]
    end

    subgraph GUI["GUI"]
        GUIapp[gui/app.py]
        GUImw[gui/views/main_window.py]
        GUIipc[gui/ipc/worker.py]
    end

    subgraph IOu["I/O"]
        IOjson[io/json_utils.py]
        IOwriters[io/nlsq_writers.py]
    end

    subgraph Utils["Cross-cutting Utils"]
        UTILlog[utils/logging.py]
    end

    subgraph Viz["Visualization"]
        VIZplots[viz/nlsq_plots.py]
    end

    COREjax --> CFGreg
    COREhom --> CFGreg
    COREhet --> CFGreg
    DATAload --> COREjax
    NLSQcore --> CFGmgr
    NLSQadapt --> COREjax
    NLSQadapt --> COREhet
    NLSQcore --> NLSQstrat
    NLSQcore --> AD1
    NLSQcore --> AD2
    NLSQcore --> AD3
    NLSQcore --> AD4
    HETcore --> AD1
    HETcore --> AD2
    HETcore --> AD3
    HETcore --> AD4
    HETengine --> NLSQstrat
    HETcore --> COREhet
    HETstrat --> HETengine
    NLSQwrap --> DEVcpu
    CLImain --> CFGmgr
    CLImain --> SVCfit
    CLIplot --> VIZplots
    SVCfit --> NLSQcore
    SVCfit --> SVCevents
    SVCdata --> DATAload
    SVCplots --> VIZplots
    GUIapp --> GUImw
    GUIipc --> SVCevents
    GUImw -.lazy runtime import.-> CLIcfg
    RUNTshell --> CLImain
    RUNTshell --> GUIapp
    INITenv --> DEVcpu
    VIZplots --> CFGmgr
    VIZplots --> COREjax
    VIZplots --> IOjson
    UTILlog -.deferred.-> CFGreg
    UTILlog -.deferred.-> IOjson
    IOwriters --> UTILlog
    DATAopt -.rejects.-> NLSQcore
